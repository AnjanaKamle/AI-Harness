# Reference list of environment variables. This file contains NO real credentials.
# The harness reads ONLY the process environment — it never loads this or any .env file.
# Export the variables in your shell (or have the evaluator provide them), e.g.:
#   export AI_API_KEY=...

# Required. Provided by the evaluator.
AI_API_KEY=

# Model provider (evaluation uses DeepSeek and Qwen; values come from the evaluator).
# AI_PROVIDER: deepseek | qwen | scripted (demo only)   - case-insensitive
# AI_MODEL:    the evaluator's model ID (required for deepseek and qwen; never guessed)
# AI_BASE_URL: endpoint; required for qwen, optional for deepseek
AI_PROVIDER=
AI_MODEL=
AI_BASE_URL=
# Optional cap on output tokens per model call (unset = provider default)
AI_MAX_OUTPUT_TOKENS=
AI_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=2

# Tool-calling loop (Coder agent)
AI_MAX_TOOL_CALLS=40
AI_MAX_TOOL_OUTPUT_CHARS=12000
AI_COMMAND_TIMEOUT_SECONDS=120

# Coder -> Tester repair loop
AI_MAX_REPAIR_ATTEMPTS=5
AI_TEST_TIMEOUT_SECONDS=300

# Context limits (every tool output and agent context package is bounded)
AI_MAX_TOOL_OUTPUT_LINES=400
AI_MAX_SEARCH_RESULTS=50
AI_MAX_CONTEXT_CHARS=16000

# Research: duckduckgo | none (web search only; the other research tools still work)
AI_RESEARCH_BACKEND=duckduckgo
AI_RESEARCH_TIMEOUT_SECONDS=15
AI_MAX_RESEARCH_RESULTS=5

# Autonomous controller: scheduling, retries, time limits
AI_MAX_CONCURRENT_AGENTS=3
AI_MAX_TOOL_RETRIES=2
AI_MAX_AGENT_RETRIES=2
AI_AGENT_TIMEOUT_SECONDS=900

# Music (optional). auto = use a local player (afplay/paplay/aplay/ffplay) if one works,
# otherwise DISABLED. none/disabled = never play. No accounts or services are used.
AI_MUSIC_BACKEND=auto
# Optional folder of your own audio files (matched by file name)
AI_MUSIC_DIR=

# Detailed log file (default: <system temp>/ai-coding-harness/harness.log)
AI_LOG_FILE=
# Demo mode pacing (AI_PROVIDER=demo only): seconds per scripted step
AI_DEMO_STEP_SECONDS=0.4

# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
