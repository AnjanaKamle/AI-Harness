# Copy to .env and fill in. Real environment variables override values here.

# --- LLM ---------------------------------------------------------------
# anthropic | mock   (mock = offline deterministic client, no API calls)
HARNESS_LLM_PROVIDER=anthropic
HARNESS_LLM_MODEL=claude-opus-5
HARNESS_LLM_MAX_TOKENS=16000
HARNESS_LLM_TIMEOUT_S=600
HARNESS_LLM_MAX_RETRIES=2
# Server-side refusal fallback: if the model declines, the API retries on a fallback model.
HARNESS_LLM_REFUSAL_FALLBACK=true

# Optional if you've run `ant auth login`; the SDK also reads ANTHROPIC_AUTH_TOKEN.
ANTHROPIC_API_KEY=

# --- Logging -----------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR | CRITICAL
HARNESS_LOG_LEVEL=INFO
# text | json
HARNESS_LOG_FORMAT=text
# Optional log file (in addition to stderr)
HARNESS_LOG_FILE=

# --- Runtime -----------------------------------------------------------
HARNESS_WORKSPACE_DIR=workspace
HARNESS_MAX_RECOVERY_ATTEMPTS=3
